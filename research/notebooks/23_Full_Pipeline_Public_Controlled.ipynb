ecutable,'-m','pytest','-q',str(WORK/'verification_tests')],cwd=WORK,text=True,capture_output=True)\n","(OUT/'analysis_tests.log').write_text(r.stdout+'\\n'+r.stderr)\n","assert r.returncode==0,r.stdout[-2500:]\n","r=subprocess.run([sys.executable,str(WORK/'evaluate_live.py'),'--source',str(SOURCE),'--cases',str(WORK/'controlled_cases.json'),'--out',str(OUT/'CONTROLLED_CANDIDATE_PREFLIGHT'),'--fixture','--only-model','Qwen'],text=True,capture_output=True)\n","(OUT/'preflight_stdout.log').write_text(r.stdout);(OUT/'preflight_stderr.log').write_text(r.stderr)\n","assert r.returncode==0,r.stderr[-2000:]\n","check=json.loads((OUT/'CONTROLLED_CANDIDATE_PREFLIGHT/Qwen/summary.json').read_text())['author_generated_controlled']\n","assert check['runtime_errors']==0 and check['authorized_nonempty_completions']==12 and check['unsafe_effect_cases']==0\n","print('Harness preflight passed: 12 real authorized commits. These are controlled candidates, not model scores.')\n"]},{"cell_type":"markdown","metadata":{},"source":["## 3. Freeze evaluation inputs"]},{"cell_type":"code","metadata":{},"execution_count":null,"outputs":[],"source":["# Public copy: excludes the separate private legacy diagnostic cohort.\n","RUN_LEGACY_DIAGNOSTIC=False\n","cases=json.loads((WORK/'controlled_cases.json').read_text())\n","if RUN_LEGACY_DIAGNOSTIC:cases+=json.loads((WORK/'legacy_cases.json').read_text())\n","CASES=WORK/'frozen_cases_public_controlled.json';CASES.write_text(json.dumps(cases,ensure_ascii=False,indent=2))\n","print('Frozen cohort counts: controlled 48; legacy 0 (private cohort omitted)')\n"]},{"cell_type":"markdown","metadata":{},"source":["## 4. Run Qwen and Granite, audit actual effects and download evidence"]},{"cell_type":"code","metadata":{},"execution_count":null,"outputs":[],"source":["# Both checkpoints run sequentially on the same source/policy/case snapshot.\n","LIVE=OUT/'ACTUAL_LIVE_MODELS'\n","run=None\n","try:\n","    run=subprocess.run([sys.executable,'-u',str(WORK/'evaluate_live.py'),'--source',str(SOURCE),'--cases',str(CASES),'--out',str(LIVE)])\n","except BaseException as error:\n","    (OUT/'LIVE_PROCESS_ERROR.txt').write_text(repr(error))\n","finally:\n","    try:\n","        if (LIVE/'manifest.json').exists():\n","            result=command([sys.executable,str(WORK/'report_results.py'),str(LIVE)])\n","            print(result.stdout)\n","            manifest=json.loads((LIVE/'manifest.json').read_text())\n","            assert manifest.get('fixture_only') is False\n","            print((LIVE/'RESULTS_AND_LIMITATIONS.md').read_text())\n","        else:print('Live runtime failed before manifest creation; no model score exists.')\n","    except Exception as error:\n","        (OUT/'REPORT_ERROR.txt').write_text(repr(error));print('Reporting failed; original partial evidence is retained.')\n","    hashes={str(p.relative_to(OUT)):hashlib.sha256(p.read_bytes()).hexdigest() for p in OUT.rglob('*') if p.is_file()}\n","    (OUT/'PACKAGE_SHA256.json').write_text(json.dumps(hashes,indent=2))\n","    archive=shutil.make_archive(str(WORK)+'_PRIVATE_RESULTS','zip',root_dir=OUT)\n","    print('Upload this results ZIP back to the chat:',archive)\n","    files.download(archive)\n","assert run is not None and run.returncode==0,'Live process failed/interrupted. Partial evidence exported; do not claim completed inference.'\n"]}]}