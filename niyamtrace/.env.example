# NiyamTrace-X Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Secrets Backend
# ---------------------------------------------------------------------------
# Options: env (default), aws, vault
NIYAMTRACE_SECRETS_BACKEND=env

# ---------------------------------------------------------------------------
# LLM API Keys
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------------
# LLM Backend Selection
# ---------------------------------------------------------------------------
# Options: gemini, groq_instructor, local
LLM_BACKEND=gemini
GROQ_MODEL=llama-3.3-70b-versatile
LOCAL_LLM_MODEL=

# ---------------------------------------------------------------------------
# NLP Model Paths (optional — leave blank to use heuristic fallbacks)
# ---------------------------------------------------------------------------
# Download AI4Bharat IndicLID from: https://github.com/AI4Bharat/Bhasha-Abhijnaanam
INDICLID_MODEL_DIR=
# Download AI4Bharat IndicXlit from: https://huggingface.co/ai4bharat/indicxlit-te-en
INDICXLIT_MODEL_DIR=

# ---------------------------------------------------------------------------
# AWS Secrets Manager (only used when NIYAMTRACE_SECRETS_BACKEND=aws)
# ---------------------------------------------------------------------------
AWS_SECRET_NAME=niyamtrace/secrets
AWS_DEFAULT_REGION=ap-south-1

# ---------------------------------------------------------------------------
# HashiCorp Vault (only used when NIYAMTRACE_SECRETS_BACKEND=vault)
# ---------------------------------------------------------------------------
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/niyamtrace

# ---------------------------------------------------------------------------
# Database (future: switch to PostgreSQL when scale requires it)
# ---------------------------------------------------------------------------
# Leave blank to use SQLite (default dev mode)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR
NIYAMTRACE_LOG_LEVEL=INFO
