# Dockerfile.gateway — NiyamTrace API Gateway
# Multi-stage build for a minimal runtime footprint.

FROM python:3.11-slim AS builder

WORKDIR /app
COPY setup.py .
COPY packages/ packages/
COPY apps/ apps/
COPY data/ data/
COPY tests/ tests/
RUN pip install --no-cache-dir build && \
    pip wheel --no-deps -w /wheels .

FROM python:3.11-slim

WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

# Optional: pre-download the smaller models to cache them in the image
# RUN pip install torch transformers && python -c "from transformers import AutoModel; AutoModel.from_pretrained('google/bert_uncased_L-2_H-128_A-2')"

COPY . .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NIYAMTRACE_LOG_LEVEL=INFO

EXPOSE 8000
CMD ["uvicorn", "apps.gateway.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
